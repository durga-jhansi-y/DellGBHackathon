{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crystal Geo experimental recognition job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "experimental", "created_at", "started_at", "finished_at", "request", "imagery", "processing", "result", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "status": {"enum": ["queued", "running", "completed", "failed", "cancelled", "interrupted"]},
    "experimental": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["region", "variant", "model_id", "model_version", "question", "zoom", "max_tokens"],
      "properties": {
        "region": {"$ref": "#/$defs/bounds"},
        "variant": {"enum": ["before", "after", "both"]},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 160},
        "question": {"type": "string", "minLength": 1, "maxLength": 2048},
        "zoom": {"const": 18},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 512}
      }
    },
    "imagery": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "generation_id", "manifest_sha256", "signature_status", "tiles"],
      "properties": {
        "dataset_id": {"const": "6971d9bc-6c17-5edc-bfc4-725e35642141"},
        "generation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "manifest_sha256": {"$ref": "#/$defs/hash"},
        "signature_status": {"const": "unsigned-development"},
        "tiles": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["key", "bounds", "source_image", "acquisition_date", "stored_sha256"],
            "properties": {
              "key": {"type": "object", "additionalProperties": false, "required": ["variant", "zoom", "x", "y"],
                "properties": {"variant": {"enum": ["before", "after"]}, "zoom": {"const": 18},
                  "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}}},
              "bounds": {"$ref": "#/$defs/bounds"},
              "source_image": {"type": "string"},
              "acquisition_date": {"type": "string", "format": "date"},
              "stored_sha256": {"$ref": "#/$defs/hash"}
            }
          }
        }
      }
    },
    "processing": {
      "type": "object", "additionalProperties": false,
      "required": ["input_profile", "adapter_resized", "server_preprocessing_verified", "model_version_verified"],
      "properties": {
        "input_profile": {"const": "stored-lossless-webp"}, "adapter_resized": {"const": false},
        "server_preprocessing_verified": {"const": false}, "model_version_verified": {"const": false}
      }
    },
    "result": {
      "oneOf": [{"type": "null"}, {
        "type": "object", "additionalProperties": false,
        "required": ["text", "actual_model_id", "backend_settings", "review_status", "uncertainty"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 8192},
          "actual_model_id": {"type": "string"}, "review_status": {"const": "unreviewed"},
          "backend_settings": {"type": "object"},
          "uncertainty": {"type": "object", "additionalProperties": false,
            "required": ["confidence", "calibrated", "note"],
            "properties": {"confidence": {"type": "null"}, "calibrated": {"const": false}, "note": {"type": "string"}}}
        }
      }]
    },
    "error": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}]}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "completed"}}},
    "then": {"properties": {"result": {"type": "object"}, "error": {"type": "null"}, "finished_at": {"type": "string"}}},
    "else": {"properties": {"result": {"type": "null"}}}}],
  "$defs": {
    "bounds": {"description": "WGS84 west/south/east/north in degrees; tile pixel grid is EPSG:3857", "type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
