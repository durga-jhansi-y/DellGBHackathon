# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Tiger Cloud (Tiger Data) Postgres connection string, from the service's
# "Connect" panel, e.g. postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=

# Tiger shows the password once at creation (or reset it in the console).
# The Postgres driver reads PGPASSWORD automatically, so it need not be in the URL.
PGPASSWORD=

# Qwen on the GB10 (OpenAI-compatible). Key is given to you in person; keep it here only.
QWEN_BASE_URL=http://10.246.100.230/v1
QWEN_MODEL=qwen3-vl-8b-instruct
QWEN_API_KEY=

# Public Hugging Face dataset (no token needed)
HF_DATASET=jennifer-fowler/UTSA-flood-images
